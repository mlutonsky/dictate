#!/bin/bash
# Usage: dictate-model [canary|parakeet]
#   no arg  -> toggle between canary and parakeet
#   arg     -> set explicitly
# The running daemon reads /tmp/dictate_model at the start of the next recording.
#
#   canary   = NemoConformerAED, translates: output language follows the
#              dictate cs/en shortcut (target_language). Speak X -> get chosen lang.
#   parakeet = NemoConformerTdt, ASR only: transcribes the spoken language,
#              ignores the cs/en choice. No translation.
MODEL_FILE="/tmp/dictate_model"
DEFAULT="canary"

current="$(cat "$MODEL_FILE" 2>/dev/null)"
case "$current" in canary|parakeet) : ;; *) current="$DEFAULT" ;; esac

if [ -n "$1" ]; then
    case "$1" in
        canary|parakeet) next="$1" ;;
        *) notify-send -t 4000 "Dictation" "Unknown model '$1' (use canary|parakeet)"; exit 1 ;;
    esac
else
    if [ "$current" = "canary" ]; then next="parakeet"; else next="canary"; fi
fi

echo "$next" > "$MODEL_FILE"

if [ "$next" = "canary" ]; then
    notify-send -t 3000 "Dictation" "Model → CANARY · translation enabled"
else
    notify-send -t 3000 "Dictation" "Model → PARAKEET · transcribes spoken language, no translation"
fi
